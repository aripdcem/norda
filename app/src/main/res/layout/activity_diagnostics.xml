<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/headingDegrees"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_dash"
            android:textSize="64sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/headingCardinal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/norda_green"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sensorStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minLines="1"
            android:textSize="14sp" />

        <TextView
            style="@style/Norda.SectionLabel"
            android:layout_marginTop="28dp"
            android:text="@string/section_location" />

        <TextView
            android:id="@+id/locationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/location_waiting"
            android:textSize="16sp" />

        <TextView
            style="@style/Norda.SectionLabel"
            android:layout_marginTop="24dp"
            android:text="@string/section_start" />

        <TextView
            android:id="@+id/startText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/start_waiting"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/filterLabel"
            style="@style/Norda.SectionLabel"
            android:layout_marginTop="24dp"
            android:text="@string/section_filter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/filterText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            style="@style/Norda.SectionLabel"
            android:layout_marginTop="24dp"
            android:text="@string/section_permission" />

        <TextView
            android:id="@+id/permissionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/permissionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:text="@string/grant_permission" />

    </LinearLayout>
</ScrollView>
